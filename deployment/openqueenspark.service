[Unit]
Description=OpenQueensPark Streamlit Web Application
After=network.target

[Service]
User=pi
WorkingDirectory=/home/pi/openqueenspark
ExecStart=/home/pi/openqueenspark/venv/bin/streamlit run app.py --server.port 8501 --server.address 127.0.0.1
Restart=always
RestartSec=5
Environment=OLLAMA_API_URL=http://localhost:11434/api/generate
Environment=OLLAMA_MODEL=llama3

[Install]
WantedBy=multi-user.target
